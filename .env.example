# AES environment template. This file contains names only; keep real values in
# an ignored local .env or in the CI secret store.

# Core local workflow
# CODEX_MODEL selects the model passed to the optional Codex orchestrator.
# CODEX_HOME is the local runtime credential/configuration directory. It must
# be an existing dedicated absolute directory outside the checkout.
# AES_INTEGRATION_BRANCH overrides the queue worker's integration branch.
# AES_APPROVED_ROOT limits queue operations to an approved repository root.
CODEX_HOME=
CODEX_MODEL=
AES_INTEGRATION_BRANCH=develop
AES_APPROVED_ROOT=

# CI identity and managed credentials (optional queue workflow). Provider
# authentication is subscription-only: AES never reads or passes provider API
# keys. GH_TOKEN is a GitHub credential for issue/PR operations, not a model
# credential.
# GH_TOKEN is read by GitHub and queue operations; provide it only through CI.
# AES_PRODUCT_MANAGER identifies the account allowed to authorize queue work.
# AES_TRUSTED_ACTOR identifies the account represented by the CI credential.
# AES_CODEX_MANAGED_CREDENTIALS must be 1 to allow managed Codex credentials.
# AES_CODEX_HOME is an optional workflow mapping: CI may expose it as the
# CODEX_HOME runtime variable. Local execution configures CODEX_HOME directly.
# AES_CLAUDE_MANAGED_SANDBOX must be 1 to enable the optional Claude fallback.
GH_TOKEN=
AES_PRODUCT_MANAGER=
AES_TRUSTED_ACTOR=
AES_CODEX_MANAGED_CREDENTIALS=
AES_CODEX_HOME=
AES_CLAUDE_MANAGED_SANDBOX=

# Queue and quota cache (optional)
# AES_QUEUE_ENABLED enables issue dispatch when set to true.
# AES_QUEUE_BUDGET caps work admitted by one dispatch cycle.
# AES_QUEUE_ALLOWED_AUTHORS is a comma-separated allow-list for issue authors.
# AES_LEASE_STALE_HOURS controls claim expiry.
# AES_QUOTA_CACHE_ROOT is an absolute directory outside the checkout.
# AES_QUOTA_CACHE_PATH is a file name or path inside that directory.
# AES_QUOTA_CACHE_TTL_SECONDS controls cache freshness.
# AES_CODEX_QUOTA_TIMEOUT_SECONDS limits the quota collector call.
# AES_SELF_HOSTED enables self-hosted queue behavior when set to true.
AES_QUEUE_ENABLED=
AES_QUEUE_BUDGET=
AES_QUEUE_MAX_CONCURRENCY=
AES_QUEUE_MAX_CONCURRENCY_PER_REPO=
AES_QUEUE_ALLOWED_AUTHORS=
AES_LEASE_STALE_HOURS=
AES_QUOTA_CACHE_ROOT=
AES_QUOTA_CACHE_PATH=
AES_QUOTA_CACHE_TTL_SECONDS=
AES_CODEX_QUOTA_TIMEOUT_SECONDS=
AES_SELF_HOSTED=

# Optional model execution limits (the queue reads these when configured).
AES_MODEL_TRANSIENT_RETRIES=
AES_MODEL_TIMEOUT_SECONDS=

# Telemetry (disabled unless explicitly enabled)
# These variables are consumed by the surrounding agent runtime, not by AES.
# Keep all content logging variables unset unless a separate privacy review
# explicitly authorizes them.
# CLAUDE_CODE_ENABLE_TELEMETRY enables metrics, logs, and traces.
# CLAUDE_CODE_ENHANCED_TELEMETRY_BETA enables additional session/tool spans.
# OTEL_METRICS_EXPORTER, OTEL_LOGS_EXPORTER, and OTEL_TRACES_EXPORTER select OTLP.
# OTEL_EXPORTER_OTLP_PROTOCOL selects the OTLP transport protocol.
# OTEL_EXPORTER_OTLP_ENDPOINT selects the operator's collector endpoint.
# OTEL_EXPORTER_OTLP_HEADERS supplies collector authentication headers.
CLAUDE_CODE_ENABLE_TELEMETRY=
CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=
OTEL_METRICS_EXPORTER=
OTEL_LOGS_EXPORTER=
OTEL_TRACES_EXPORTER=
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
